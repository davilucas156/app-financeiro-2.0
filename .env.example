# Modelo de variáveis de ambiente. Copie para `.env.local` e preencha.
# `.env.local` está no .gitignore — nunca versione chave real.
#
# Regra do projeto (references/architecture.md — Thin Client, Fat Server):
# só variáveis com o prefixo NEXT_PUBLIC_ chegam ao navegador. Toda chave
# secreta fica SEM esse prefixo e é usada exclusivamente no servidor.

# ── Clerk (autenticação) ─────────────────────────────────── tarefa D1
# Pública — vai para o bundle do cliente, é seguro expor.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# SECRETA — apenas servidor.
CLERK_SECRET_KEY=
# SECRETA — valida a assinatura do webhook do Clerk.  tarefa D4
CLERK_WEBHOOK_SIGNING_SECRET=
# Públicas — mandam o Clerk usar as nossas telas em vez das dele.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/cadastrar

# ── Allowlist (acesso por convite) ───────────────────────── tarefa D3
# SECRETA (sem prefixo público): quem tem acesso não vai para o navegador.
# Separada por vírgula. **Vazia = ninguém entra** — falha fechado de
# propósito, para um deploy sem a variável trancar em vez de abrir.
EMAILS_CONVIDADOS=

# ── Seed das regras-base ─────────────────────────────────── tarefa D7
# SECRETA (sem prefixo público). Quem nasce com as 25 regras da A5.
# É uma lista **própria**, e não a do convite: aquela responde "quem pode
# entrar", outra pergunta. Convidar alguém não pode fazer essa pessoa herdar
# o mecânico do Davi. **Vazia = ninguém recebe.**
EMAILS_COM_REGRAS_BASE=

# ── Postgres (Neon / Vercel Postgres) ────────────────────── tarefa C1
# SECRETA — string de conexão. Nunca acessada pelo cliente.
DATABASE_URL=

# Conexão **direta**, sem o pooler. Só o `drizzle-kit` a usa (generate,
# migrate, studio): o pgbouncer da Neon não sustenta bem DDL longo. A
# aplicação usa a de cima. A Neon entrega as duas no mesmo painel.
DATABASE_URL_UNPOOLED=

# ── API Anthropic (fallback de classificação) ── spec do motor de classificação
# SECRETA. Usada só em server action / route handler.
ANTHROPIC_API_KEY=
